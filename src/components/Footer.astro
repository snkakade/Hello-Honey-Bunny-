---
import { navItems, site } from "../config/site.js";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="assets/images/logo.png" alt="Hello Honey Bunny" width="126" height="89" loading="lazy">
        <p>{site.description}</p>
      </div>
      <div class="footer-column">
        <h2>Explore</h2>
        {navItems.slice(0, 4).map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer-column">
        <h2>Order</h2>
        <a href="shop.html">Shop</a>
        <a href="contact.html">Contact</a>
        <a href="contact.html#partners">For cafés &amp; retailers</a>
        <a href="contact.html#visit">Visit the farm</a>
      </div>
      <div class="footer-column">
        <h2>Find us</h2>
        <a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.social.instagram} aria-label="Instagram placeholder">Instagram</a>
        <a href={site.social.facebook} aria-label="Facebook placeholder">Facebook</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© <span data-year>{new Date().getFullYear()}</span> Hello Honey Bunny. All rights reserved.</p>
      <a
        class="footer-credit"
        href="https://www.shreyashkakade.com/websites/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Designed and Managed by <strong>Shreyash Kakade</strong>
      </a>
      <p>{site.location}</p>
    </div>
  </div>
</footer>
