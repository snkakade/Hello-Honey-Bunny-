---
import { navItems, site } from "../config/site.js";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="assets/images/logo.png" alt="Hello Honey Bunny" width="126" height="89" loading="lazy">
        <p>{site.description}</p>
      </div>
      <div class="footer-column">
        <h2>Explore</h2>
        {navItems.slice(0, 4).map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer-column">
        <h2>Order</h2>
        <a href="shop.html">Shop</a>
        <a href="contact.html">Contact</a>
        <a href="contact.html#partners">For cafés &amp; retailers</a>
        <a href="contact.html#visit">Visit the farm</a>
      </div>
      <div class="footer-column">
        <h2>Find us</h2>
        <a class="footer-social-link" href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.9-1.1A8.5 8.5 0 1 0 12 3Zm0 15.3c-1.2 0-2.4-.3-3.4-.9l-.3-.2-2.9.7.7-2.8-.2-.3A6.8 6.8 0 1 1 12 18.3Zm3.8-5.1c-.2-.1-1.2-.6-1.4-.7-.2-.1-.4-.1-.5.1l-.6.7c-.1.2-.3.2-.5.1-1.3-.6-2.2-1.4-2.8-2.5-.2-.3.2-.5.6-.9.1-.1.1-.3.1-.4 0-.1-.5-1.3-.7-1.8-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.9 2.3 1 2.5c.1.2 1.8 2.8 4.4 3.8 1.6.7 2.2.7 3 .6.5-.1 1.2-.5 1.4-1 .2-.5.2-.9.1-1-.1-.2-.3-.3-.7-.4Z"/></svg>
          <span>WhatsApp</span>
        </a>
        <a class="footer-social-link" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Zm8 7.2 7.2-5.4H4.8l7.2 5.4Zm0 2.2L4 8.9v7.6h16V8.9l-8 6Z"/></svg>
          <span>Email</span>
        </a>
        <a class="footer-social-link" href={site.social.instagram} aria-label="Instagram placeholder">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Zm9.8 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
          <span>Instagram</span>
        </a>
        <a class="footer-social-link" href={site.social.facebook} aria-label="Facebook placeholder">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.3c-.5-.1-1.8-.3-3.4-.3-3.3 0-5.6 2-5.6 5.8V13H4v4h4v7h5v-7h3.3l.7-4h-4V10c0-1.2.3-2 2-2Z"/></svg>
          <span>Facebook</span>
        </a>
        <a class="footer-social-link" href={site.social.linkedin} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 7.8A2.3 2.3 0 1 1 5.2 3a2.3 2.3 0 0 1 0 4.7ZM3.3 9.5h3.8V21H3.3V9.5Zm6.2 0h3.7v1.6h.1c.5-1 1.8-2 3.6-2 3.9 0 4.6 2.5 4.6 5.9v6h-3.8v-5.3c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V21H9.5V9.5Z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© <span data-year>{new Date().getFullYear()}</span> Hello Honey Bunny. All rights reserved.</p>
      <a
        class="footer-credit"
        href="https://www.shreyashkakade.com/websites/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Designed and Managed by <strong>Shreyash Kakade</strong>
      </a>
      <p>{site.location}</p>
    </div>
  </div>
</footer>
