---
import { site, withBase } from "../config/site";
const links = [["Fresh Goat Milk", "/fresh-goat-milk"], ["Goat Milk Paneer", "/goat-milk-paneer"], ["Delivery Areas", "/delivery-areas"], ["Request a Batch", "/request-a-batch"], ["Our Farm", "/our-farm"], ["For Food Businesses", "/for-chefs-and-retailers"], ["FAQs", "/faqs"], ["Contact", "/contact"], ["Privacy", "/privacy"]];
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><a class="footer-logo" href={withBase("/")} aria-label="Hello Honey Bunny home"><img src={withBase("/assets/brand/official-full-logo.svg")} width="720" height="720" alt="" loading="lazy" /></a><p>{site.description}</p><p>{site.location}</p><p>Delivery requests across Pune, nearby PCMC and listed local areas.</p><a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener">WhatsApp {site.phoneDisplay}</a></div>
    <nav aria-label="Footer navigation">{links.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}</nav>
    <div><h2>Elsewhere</h2><a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={`mailto:${site.email}`}>{site.email}</a></div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} Hello Honey Bunny</p></div>
</footer>
