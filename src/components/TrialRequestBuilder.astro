---
import { requestableProducts, statusLabels } from "../data/products";
import { site, withBase } from "../config/site";
---
<section class="section section-cream trial-builder-section" id="trial-request">
  <div class="container">
    <div class="request-layout trial-request-layout" data-request-builder data-whatsapp={site.whatsappNumber} data-max-quantity={site.maxRequestQuantity}>
      <div class="request-products">
        <div class="trial-product-heading"><h2>Choose products</h2><span>500 ml selected</span></div>
        {requestableProducts.map((product) => <article class="request-product" data-product-id={product.id} data-product-name={product.name}>
          <div><p class="status">{statusLabels[product.status]}</p><h3>{product.name}</h3>{product.id === "goat-milk-paneer" && <p class="product-add-on">Optional add-on for the same request</p>}</div>
          {product.indicativePackSizes.map((size, index) => {
            const initial = product.id === "fresh-goat-milk" && index === 0 ? 1 : 0;
            return <div class="pack-control" data-size={size} data-initial-quantity={initial}>
              <span>{size}</span>
              <div class="quantity-control" role="group" aria-label={`${product.name}, ${size} quantity`}>
                <button type="button" data-action="decrease" aria-label={`Remove one ${product.name}, ${size}`}>−</button>
                <output aria-live="polite">{initial}</output>
                <button type="button" data-action="increase" aria-label={`Add one ${product.name}, ${size}`}>+</button>
              </div>
            </div>;
          })}
        </article>)}
      </div>
      <aside class="form-panel trial-form-panel" aria-label="Trial request details">
        <p class="eyebrow">One quick check</p><h2>Your details</h2>
        <form id="batch-form" novalidate>
          <div class="field-grid">
            <div class="field"><label for="request-name">Name *</label><input id="request-name" name="name" autocomplete="name" required aria-describedby="request-name-error"><p class="field-error" id="request-name-error"></p></div>
            <div class="field"><label for="request-area">Area or postcode *</label><input id="request-area" name="area" autocomplete="postal-code" required aria-describedby="request-area-help request-area-error"><p class="field-help" id="request-area-help">Pune and nearby service areas. <a href={withBase("/delivery-areas")}>View delivery areas</a>.</p><p class="field-error" id="request-area-error"></p></div>
            <div class="field"><label for="request-arrangement">Preferred arrangement *</label><select id="request-arrangement" name="arrangement" required aria-describedby="request-arrangement-error"><option value="">Select a preference</option><option>Pickup, if available</option><option>Delivery, if available</option><option>Either option</option></select><p class="field-error" id="request-arrangement-error"></p></div>
            <div class="field"><label for="request-date">Preferred date</label><input id="request-date" name="date" type="date" aria-describedby="request-date-error"><p class="field-error" id="request-date-error"></p></div>
            <div class="field trial-field-full"><label for="request-notes">Anything we should know?</label><textarea id="request-notes" name="notes" placeholder="Timing or practical details"></textarea></div>
          </div>
          <button class="button button-accent trial-submit" type="submit"><span class="trial-submit-full">Check price &amp; availability on WhatsApp</span><span class="trial-submit-short">Check on WhatsApp</span> <span aria-hidden="true">↗</span></button>
          <p class="submit-reassurance">No payment on this page. Review the prepared message before sending.</p>
          <p id="request-status" class="form-status" role="status" aria-live="polite"></p>
          <p class="privacy-note">Your entries stay in this page until you continue to WhatsApp. Read our <a href={withBase("/privacy")}>privacy information</a>.</p>
        </form>
        <div class="fallback" data-fallback hidden><h4>Your prepared request</h4><pre data-request-text></pre><button class="button button-secondary" type="button" data-copy-request>Copy request</button><p>WhatsApp: {site.phoneDisplay}</p><p data-copy-status role="status" aria-live="polite"></p></div>
      </aside>
    </div>
  </div>
</section>
