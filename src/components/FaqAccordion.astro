---
import { withBase } from "../config/site";
import type { FaqItem } from "../data/faqs";
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((item) => <details><summary>{item.question}</summary><div><p>{item.answer}</p>{item.link && <a href={withBase(item.link.href)}>{item.link.label}</a>}</div></details>)}
</div>
