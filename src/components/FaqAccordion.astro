---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<div class:list={["accordion", className]} data-accordion>
  {items.map((item) => (
    <article class="faq-item">
      <button class="faq-question" type="button">{item.question}</button>
      <div class="faq-answer">
        <div class="faq-answer-inner"><p>{item.answer}</p></div>
      </div>
    </article>
  ))}
</div>
