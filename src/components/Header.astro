---
import { navItems, withBase } from "../config/site";
interface Props { activePage?: string }
const { activePage = "" } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={withBase("/")} aria-label="Hello Honey Bunny home"><img src={withBase("/assets/brand/logo.svg")} width="640" height="160" alt="" /></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span>Open menu</span></button>
    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      {navItems.map((item) => <a href={withBase(item.href)} aria-current={activePage === item.page ? "page" : undefined}>{item.label}</a>)}
      <a class="button button-primary nav-cta" href={withBase("/request-a-batch")} aria-current={activePage === "request" ? "page" : undefined}>Check Current Batch</a>
    </nav>
  </div>
</header>
