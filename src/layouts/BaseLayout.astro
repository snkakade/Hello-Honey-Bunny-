---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  activePage?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  activePage = "",
  image = "/assets/images/editorial/farm-morning.webp",
  schema,
  preloadImage
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={socialImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImage}>
    <meta name="theme-color" content="#f7f1e6">
    <link rel="icon" href="/assets/images/logo.png">
    <link rel="manifest" href="/site.webmanifest">
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp">}
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header activePage={activePage} />
    <slot />
    <Footer />
    <script>
      import "../scripts/index.js";
    </script>
  </body>
</html>
