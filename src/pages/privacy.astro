---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { site } from "../config/site"; import { breadcrumbSchema } from "../utils/schema";
---
<BaseLayout title="Privacy | Hello Honey Bunny" description="How the static Hello Honey Bunny website handles information entered into WhatsApp and email enquiry forms." canonicalPath="/privacy" schema={breadcrumbSchema([{name:"Home",path:"/"},{name:"Privacy",path:"/privacy"}])}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"Privacy"}]} /><section class="page-intro"><div class="narrow"><p class="eyebrow">Website information</p><h1>Privacy</h1><p class="lede">This website is static. It uses the details you enter to create a message for WhatsApp or email.</p></div></section><section class="section section-cream"><div class="narrow"><h2>Form information</h2><p>Form values are processed in your browser to format your request. They are transferred only if you continue to WhatsApp or your email service. The website does not itself send or store those form values.</p><h2>Other services</h2><p>WhatsApp or Meta may process a message after you continue to WhatsApp. Your email provider and the recipient's email provider may process an email after you send it. Their own terms and privacy practices apply.</p><h2>Analytics and cookies</h2><p>No analytics service or advertising tracker is currently included in this website. The site does not set its own analytics or advertising cookies.</p><h2>Contact</h2><p>Questions can be sent to <a href={`mailto:${site.email}`}>{site.email}</a> or by WhatsApp at <a href={`https://wa.me/${site.whatsappNumber}`}>{site.phoneDisplay}</a>.</p></div></section></main></BaseLayout>
