---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { Picture } from "astro:assets"; import { getProduct, statusLabels } from "../data/products"; import { breadcrumbSchema, productSchema } from "../utils/schema"; import { withBase } from "../config/site";
const product=getProduct("goat-milk-paneer"); const crumbs=[{name:"Home",path:"/"},{name:product.name,path:product.slug}];
---
<BaseLayout title={product.seoTitle!} description={product.seoDescription!} canonicalPath={product.slug} activePage="paneer" image={product.image?.src} imageAlt={product.imageAlt} schema={[productSchema(product),breadcrumbSchema(crumbs)]}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:product.name}]} /><section class="page-intro"><div class="container hero-grid"><div><p class="status">{statusLabels[product.status]}</p><h1>Goat milk paneer near Pune</h1><p class="lede">{product.longDescription} Availability and final pricing are confirmed personally on WhatsApp.</p><div class="button-row"><a class="button button-primary" href={withBase("/request-a-batch?product=goat-milk-paneer")}>Request goat milk paneer</a><a class="button button-secondary" href={withBase("/fresh-goat-milk")}>View fresh goat milk</a></div></div><div class="hero-media"><Picture src={product.image!} formats={["avif"]} fallbackFormat="webp" widths={[480,768,1100]} sizes="(max-width: 750px) 100vw, 48vw" alt={product.imageAlt!} fetchpriority="high" loading="eager" decoding="async" /></div></div></section><section class="section section-cream"><div class="container feature-grid"><article class="feature"><h2>Indicative pack sizes</h2><p>200 g and 400 g. Pack sizes are indicative and confirmed with each available batch.</p></article><article class="feature"><h2>Delivery around Pune</h2><p>Delivery requests are considered across Pune, nearby PCMC and our listed local areas. <a href={withBase("/delivery-areas")}>Check the current delivery areas</a>; route availability is confirmed with each batch.</p></article></div></section><section class="section"><div class="narrow"><h2>Handling and serving ideas</h2><p>{product.storageSummary} Use clean utensils. It can be served in curries, grilled dishes, wraps or salads according to your recipe.</p><p><a href={withBase("/products")}>Compare the current product range</a> or <a href={withBase("/faqs")}>read ordering and storage FAQs</a>.</p></div></section></main></BaseLayout>
