---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { requestableProducts } from "../data/products";
import { homeFaqs } from "../data/faqs";
import { availabilityMessage, whatsappUrl, withBase } from "../config/site";
import { homeSchema } from "../utils/schema";
import { Picture } from "astro:assets";
import landscapeArt from "../assets/images/illustrated-landscape-v2.webp";
import stillLifeArt from "../assets/images/illustrated-still-life-v2.webp";
import farmImage from "../assets/images/farm-morning.webp";
import milkWideArt from "../assets/images/illustrated-milk-wide-v4.png";
import paneerWideArt from "../assets/images/illustrated-paneer-wide-v4.png";
const whatsapp = whatsappUrl(availabilityMessage);
const productCardImages = [milkWideArt, paneerWideArt];
---
<BaseLayout title="Small-Batch Goat Dairy Near Pune | Hello Honey Bunny" description="Fresh goat milk and goat milk paneer can be requested from Hello Honey Bunny in Kunjirwadi, near Pune. Confirm the current batch personally on WhatsApp." canonicalPath="/" schema={homeSchema()}>
  <main id="main">
    <section class="hero hero-editorial" data-hero>
      <div class="hero-sun" aria-hidden="true"></div>
      <div class="container hero-editorial-grid">
        <div class="hero-copy" data-hero-copy>
          <p class="eyebrow">Goat dairy in Kunjirwadi, near Pune</p>
          <h1>Fresh goat milk <em>and paneer</em></h1>
          <p class="lede">Hello Honey Bunny is a small goat dairy in Kunjirwadi. We offer fresh goat milk and goat milk paneer in limited batches, with current availability and practical details shared directly.</p>
          <div class="button-row">
            <a class="button button-primary button-arrow" href={whatsapp} target="_blank" rel="noopener">Ask about availability <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href={withBase("/products")}>See current products</a>
          </div>
        </div>
        <div class="hero-art" data-hero-art>
          <div class="hero-art-frame">
            <Picture src={landscapeArt} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1440, 1920]} sizes="(max-width: 820px) 100vw, 56vw" alt="Illustrated rolling landscape with a goat and dairy vessels" fetchpriority="high" loading="eager" decoding="async" />
          </div>
          <div class="hero-stamp" aria-hidden="true"><span>Our dairy</span><strong>Kunjirwadi</strong></div>
          <div class="hero-note"><span aria-hidden="true">✦</span><p>Fresh goat milk and paneer, offered in limited batches.</p></div>
        </div>
      </div>
    </section>

    <div class="ticker" aria-label="Hello Honey Bunny service summary"><div class="ticker-track">
      {["Fresh goat milk", "Goat milk paneer", "Current batch availability", "Kunjirwadi near Pune", "Confirmed personally on WhatsApp", "Fresh goat milk", "Goat milk paneer"].map((item) => <span>{item}<b aria-hidden="true">✦</b></span>)}
    </div></div>

    <section class="section products-showcase" id="current-products">
      <div class="container">
        <div class="section-heading section-heading-display" data-reveal>
          <p class="eyebrow">What you can request now</p>
          <h2>Two products. <em>One clear answer.</em></h2>
          <p>Small-batch availability changes. The website keeps the choice simple, and we confirm the detail with you directly.</p>
        </div>
        <div class="product-grid product-grid-editorial">{requestableProducts.map((product, index) => <div class="product-wrap" data-reveal data-product-index={`0${index + 1}`}><ProductCard product={product} image={productCardImages[index]} /></div>)}</div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container process-layout">
        <div class="process-intro" data-reveal><p class="eyebrow">How requests work</p><h2>From a quick request to a confirmed arrangement.</h2><p>No cart, no guessed inventory and no premature promise. Just the useful details, handled person to person.</p><a class="text-link link-arrow" href={withBase("/request-a-batch")}>Build your batch request <span aria-hidden="true">→</span></a></div>
        <div class="steps steps-editorial">{[
          ["01", "Choose", "Select a product and indicative pack size"], ["02", "Send", "Open your prepared request in WhatsApp"], ["03", "Check", "Receive availability and final pricing"], ["04", "Confirm", "Agree the available pickup or delivery arrangement"]
        ].map(([number, title, copy]) => <article class="step" data-reveal><span class="step-number">{number}</span><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div>
      </div>
    </section>

    <section class="section story-section">
      <div class="container story-editorial">
        <div class="story-art" data-reveal="image"><Picture src={stillLifeArt} formats={["avif"]} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 46vw" alt="Illustrated goat, milk bowl and paneer still life" loading="lazy" decoding="async" /><span class="art-label">An illustrative study of the current range</span></div>
        <div class="story-copy" data-reveal>
          <p class="eyebrow">Small-batch availability</p>
          <h2>Made in considered quantities, never presented as live stock.</h2>
          <p class="large-copy">The website gives you a useful starting point. The farm gives you the current answer.</p>
          <p>Availability follows the current farm batch. Products are carefully chilled, and final pricing and fulfilment details are confirmed personally for every request.</p>
          <div class="mini-grid"><div><span aria-hidden="true">01</span><strong>Keep refrigerated</strong><p>Follow the storage and use-by guidance supplied with your confirmed batch.</p></div><div><span aria-hidden="true">02</span><strong>Use clean utensils</strong><p>Simple handling guidance stays clear and batch-specific.</p></div></div>
        </div>
      </div>
    </section>

    <section class="section location-section">
      <div class="container location-card" data-reveal>
        <div class="location-photo"><Picture src={farmImage} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(max-width: 760px) 100vw, 52vw" alt="Goats standing near a timber farm shelter" loading="lazy" decoding="async" /></div>
        <div class="location-copy"><p class="eyebrow">Find the farm</p><h2>Kunjirwadi, Maharashtra 412201</h2><p>Our small goat dairy is near Pune. Farm visits require prior confirmation, and private directions are not published on the website.</p><a class="button button-light" href={withBase("/our-farm")}>Step inside our farm story</a></div>
      </div>
    </section>

    <section class="section business-section">
      <div class="business-orbit orbit-one" aria-hidden="true"></div><div class="business-orbit orbit-two" aria-hidden="true"></div>
      <div class="container business-grid"><div data-reveal><p class="eyebrow">For food businesses</p><h2>Planning thoughtful supply with Pune kitchens and shops.</h2></div><div data-reveal><p>Chefs, cafés, restaurants and specialist retailers may start a conversation about current or future small-batch supply. An enquiry is not a promise of immediate availability.</p><a class="button button-accent button-arrow" href={withBase("/for-chefs-and-retailers")}>Start a food business enquiry <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="section faq-home"><div class="narrow"><div class="section-heading section-heading-display center" data-reveal><p class="eyebrow">Good to know</p><h2>Clear answers, <em>before you ask.</em></h2></div><FaqAccordion items={homeFaqs} /><p class="faq-more"><a class="text-link link-arrow" href={withBase("/faqs")}>Read all goat milk and farm FAQs <span aria-hidden="true">→</span></a></p></div></section>

    <section class="section final-cta"><div class="container cta-band" data-reveal><div><p class="eyebrow">Current availability</p><h2>Ask about the current batch.</h2><p>Send a short WhatsApp message and receive the details personally.</p></div><a class="button button-light button-arrow" href={whatsapp} target="_blank" rel="noopener">Check current batch <span aria-hidden="true">↗</span></a><span class="cta-mark" aria-hidden="true">HB</span></div></section>
  </main>
</BaseLayout>
