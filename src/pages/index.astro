---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { requestableProducts } from "../data/products";
import { homeFaqs } from "../data/faqs";
import { availabilityMessage, whatsappUrl, withBase } from "../config/site";
import { homeSchema } from "../utils/schema";
import { Picture } from "astro:assets";
import dairyImage from "../assets/images/dairy-still-life.webp";
const whatsapp = whatsappUrl(availabilityMessage);
---
<BaseLayout title="Small-Batch Goat Dairy Near Pune | Hello Honey Bunny" description="Fresh goat milk and goat milk paneer can be requested from Hello Honey Bunny in Kunjirwadi, near Pune. Confirm the current batch personally on WhatsApp." canonicalPath="/" schema={homeSchema()}>
  <main id="main">
    <section class="hero"><div class="container hero-grid">
      <div class="hero-copy"><p class="eyebrow">Kunjirwadi, near Pune</p><h1>Small-batch goat milk near Pune</h1><p class="lede">Fresh goat milk and goat milk paneer can currently be requested in limited batches. Availability, final pricing, pickup and delivery options are confirmed personally on WhatsApp.</p><div class="button-row"><a class="button button-primary" href={whatsapp} target="_blank" rel="noopener">Check current batch on WhatsApp</a><a class="button button-secondary" href={withBase("/products")}>View milk and paneer</a></div></div>
      <div class="hero-media"><Picture src={dairyImage} formats={["avif"]} fallbackFormat="webp" widths={[480, 768, 1100]} sizes="(max-width: 750px) 100vw, 48vw" alt="Milk bottle and glass arranged on a light table" fetchpriority="high" loading="eager" decoding="async" /></div>
    </div></section>

    <section class="section section-cream"><div class="container"><div class="section-heading"><p class="eyebrow">Current products</p><h2>Milk and paneer available by request</h2><p>Pack sizes are indicative. Current options are confirmed with each batch.</p></div><div class="product-grid">{requestableProducts.map((product) => <ProductCard product={product} />)}</div></div></section>

    <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">How requests work</p><h2>A request becomes an arrangement after confirmation</h2></div><div class="steps">{[
      ["01", "Choose", "Choose a product and indicative pack size"], ["02", "Send", "Send the request through WhatsApp"], ["03", "Check", "Receive confirmation of current availability and final pricing"], ["04", "Confirm", "Confirm the available pickup or delivery arrangement"]
    ].map(([number, title, copy]) => <article class="step"><span class="step-number">{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section section-forest"><div class="container split-grid"><div><p class="eyebrow">Small-batch availability</p><h2>The website does not show live inventory</h2></div><div><p>Availability follows the current farm batch. Products are prepared in considered quantities, so current options, final pricing and fulfilment details are confirmed personally for every request.</p></div></div></section>

    <section class="section"><div class="container feature-grid"><article class="feature"><p class="eyebrow">Handling and storage</p><h2>Keep chilled and follow the batch guidance</h2><p>Products are carefully chilled. Keep them refrigerated, use clean utensils and follow the storage and use-by guidance supplied with your confirmed batch.</p></article><article class="feature"><p class="eyebrow">Farm and location</p><h2>Kunjirwadi, Maharashtra 412201</h2><p>Our small goat dairy is near Pune. Farm visits require prior confirmation, and private directions are not published on the website.</p><a class="text-link" href={withBase("/our-farm")}>Learn about our farm</a></article></div></section>

    <section class="section section-cream"><div class="container split-grid"><div><p class="eyebrow">For food businesses</p><h2>Planning thoughtful supply with Pune food businesses</h2></div><div><p>Chefs, cafés, restaurants and specialist retailers may start a conversation about current or future small-batch supply. An enquiry is not a promise of immediate availability.</p><a class="button button-secondary" href={withBase("/for-chefs-and-retailers")}>Start a food business enquiry</a></div></div></section>

    <section class="section"><div class="narrow"><div class="section-heading center"><p class="eyebrow">Essential questions</p><h2>What to know before requesting</h2></div><FaqAccordion items={homeFaqs} /><p><a class="text-link" href={withBase("/faqs")}>Read all goat milk and farm FAQs</a></p></div></section>
    <section class="section section-cream"><div class="container cta-band"><div><p class="eyebrow">Current availability</p><h2>Ask about the current batch</h2><p>Send a short WhatsApp message and receive the details personally.</p></div><a class="button button-light" href={whatsapp} target="_blank" rel="noopener">Check current batch on WhatsApp</a></div></section>
  </main>
</BaseLayout>
