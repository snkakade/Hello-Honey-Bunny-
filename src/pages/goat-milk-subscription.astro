---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import milkArt from "../assets/images/illustrated-milk-wide-v4.png";
import { breadcrumbSchema } from "../utils/schema";
import { whatsappUrl, withBase } from "../config/site";

const plans = [
  { name: "Weekly 2", quantity: "2 litres/week", cycle: "Approximately 8 L per four-week cycle", fit: "A lighter regular quantity for one- or two-person households.", value: "Plan value designed around approximately 3%", featured: false },
  { name: "Weekly 4", quantity: "4 litres/week", cycle: "Approximately 16 L per four-week cycle", fit: "A practical regular allocation for household use.", value: "Plan value designed around approximately 5%", featured: true },
  { name: "Weekly 7", quantity: "1 litre/day allocation", cycle: "Approximately 28 L per four-week cycle", fit: "For households with higher, consistent milk consumption.", value: "Plan value capped at approximately 7%", featured: false }
];
const planUrl = (plan: string, quantity: string) => whatsappUrl(`Hello, I would like to discuss the ${plan} goat milk plan (${quantity}). Please confirm whether my area fits a current delivery route, the available schedule, four-week cycle price and subscription terms.`);
const subscriptionWhatsapp = whatsappUrl("Hello, I would like to reserve a regular weekly goat milk allocation. Please help me choose a suitable plan and confirm the available delivery route, schedule, four-week cycle price and subscription terms for my area.");
const crumbs = [{ name: "Home", path: "/" }, { name: "Goat Milk Subscription", path: "/goat-milk-subscription" }];
---
<BaseLayout title="Weekly Goat Milk Subscription Near Pune | Hello Honey Bunny" description="Reserve a planned weekly goat milk allocation in a four-week cycle, with route-based delivery around Pune and nearby areas, subject to farm production and subscription terms." canonicalPath="/goat-milk-subscription" activePage="milk" image={milkArt.src} imageAlt="Illustrated fresh goat milk bottle in a farm landscape" schema={breadcrumbSchema(crumbs)}>
  <main id="main" class="conversion-page subscription-page">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Goat Milk Subscription" }]} />
    <section class="conversion-hero subscription-hero">
      <div class="container conversion-hero-grid">
        <div class="conversion-copy">
          <p class="eyebrow">A steadier weekly rhythm</p>
          <h1>Fresh goat milk, reserved for you each week</h1>
          <p class="lede">Choose your regular quantity and preferred delivery days. We reserve your planned quantity from available production and confirm the delivery schedule with you.</p>
          <div class="button-row"><a class="button button-primary button-arrow conversion-primary" href="#plans">Compare weekly plans <span aria-hidden="true">↓</span></a><a class="button button-secondary" href={subscriptionWhatsapp} target="_blank" rel="noopener" data-analytics-location="subscription_hero" data-analytics-label="Check subscription availability">Check your area on WhatsApp</a></div>
          <p class="cta-reassurance">Four-week cycle. Pause with advance notice. Final price and route confirmed before you start.</p>
        </div>
        <div class="conversion-art subscription-art">
          <Picture src={milkArt} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(max-width: 820px) 100vw, 46vw" alt="Illustrated fresh goat milk bottle with a goat and rolling farmland" fetchpriority="high" loading="eager" decoding="async" />
          <div class="offer-ticket"><span>Four-week cycle</span><strong>Reserved allocation</strong><small>Subject to farm production</small></div>
        </div>
      </div>
    </section>
    <section class="section section-cream plan-section" id="plans">
      <div class="container">
        <div class="section-heading section-heading-display"><p class="eyebrow">Choose a useful quantity</p><h2>Three plans, without artificial tiers.</h2><p>Each plan reserves a planned weekly allocation. The current cycle price, delivery arrangement and precise combination of plan benefits are confirmed personally before prepayment.</p></div>
        <div class="plan-grid">
          {plans.map((plan) => <article class:list={["plan-card", { "plan-card-featured": plan.featured }]}>
            {plan.featured && <p class="plan-label">Practical household plan</p>}
            <p class="plan-name">{plan.name}</p><h3>{plan.quantity}</h3><p>{plan.fit}</p><p class="plan-cycle">{plan.cycle}</p>
            <ul><li>Reserved weekly allocation</li><li>Route-linked delivery schedule</li><li>Pause with advance notice</li><li>{plan.value}</li></ul>
            <a class:list={["button", plan.featured ? "button-primary" : "button-secondary"]} href={planUrl(plan.name, plan.quantity)} target="_blank" rel="noopener" data-analytics-location={`subscription_${plan.name.toLowerCase().replace(" ", "_")}`} data-analytics-label={`Ask about ${plan.name}`}>Ask about {plan.name}</a>
          </article>)}
        </div>
        <p class="plan-note"><strong>How the plan value works:</strong> it may be reflected through the milk price, route-linked delivery terms or a paneer add-on benefit. The exact mix is confirmed before the four-week cycle begins; it is not a promise of a permanent milk discount.</p>
      </div>
    </section>
    <section class="section route-section">
      <div class="container route-layout">
        <div class="route-intro"><p class="eyebrow">Delivery that remains practical</p><h2>Your schedule follows an available route.</h2><p class="large-copy">Consolidated delivery days keep a regular plan workable for both the household and the farm.</p><p>Tell us your area first. We will match it to a current corridor and offer the available day rather than promising arbitrary Pune-wide delivery every day.</p></div>
        <ol class="route-list">
          <li><span>A</span><div><h3>East &amp; South-East</h3><p>Kunjirwadi → Loni Kalbhor → Hadapsar → nearby areas</p></div></li>
          <li><span>B</span><div><h3>South Pune</h3><p>Kunjirwadi → Katraj → adjoining areas</p></div></li>
          <li><span>C</span><div><h3>Pune Central</h3><p>Consolidated delivery days, confirmed with the plan</p></div></li>
          <li><span>D</span><div><h3>PCMC</h3><p>Consolidated runs when subscriber density makes the route practical</p></div></li>
        </ol>
      </div>
    </section>
    <section class="section section-forest subscription-terms">
      <div class="container conversion-split">
        <div><p class="eyebrow">An honest agricultural promise</p><h2>Reserved does not mean unlimited.</h2></div>
        <div><p class="large-copy">Reserved weekly allocation, subject to the farm's production and the subscription terms.</p><p>Milk production can vary. If production affects a planned allocation, we will communicate the available quantity and arrangement directly. Plans do not promise fixed delivery irrespective of farm conditions.</p><p>One-off orders remain available through the <a href={withBase("/fresh-goat-milk")}>current fresh goat milk batch</a>.</p></div>
      </div>
    </section>
    <section class="section final-cta">
      <div class="container cta-band">
        <div><p class="eyebrow">Find your weekly fit</p><h2>Tell us your quantity and area.</h2><p>We will confirm the suitable plan, current route, cycle price and terms before you commit.</p></div>
        <a class="button button-light button-arrow" href={subscriptionWhatsapp} target="_blank" rel="noopener" data-analytics-location="subscription_final_cta" data-analytics-label="Reserve a weekly allocation">Discuss a weekly plan <span aria-hidden="true">↗</span></a>
        <span class="cta-mark" aria-hidden="true">4W</span>
      </div>
    </section>
  </main>
</BaseLayout>
