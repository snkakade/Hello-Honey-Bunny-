---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { faqs } from "../data/faqs.js";

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer }
  }))
};
---

<BaseLayout
  title="Goat Milk & Farm FAQs | Hello Honey Bunny Pune"
  description="Answers about Hello Honey Bunny, fresh goat milk near Pune, delivery, small-batch products, storage, subscriptions, partnerships and farm visits."
  canonicalPath="/faq.html"
  activePage="faq"
  image="/assets/images/editorial/farm-morning.webp"
  schema={schema}
>
  <main id="main">
<PageHero
  eyebrow="Questions, plainly answered"
  title="Good to know."
  description="Where we are, what is available and how the first batches will work—without gloss or fine-print surprises."
  variant="faq"
>
      <div slot="visual" class="page-hero-visual question-stage" data-motion-scene data-reveal="right">
        <div class="visual-frame portrait-frame" data-depth-layer="1"><img src="/assets/images/editorial/goat-portrait.webp" alt="Curious young goat looking through meadow grasses" width="1122" height="1402"></div>
        <span class="question-bubble bubble-one" data-depth-layer="4">Delivery?</span>
        <span class="question-bubble bubble-two" data-depth-layer="3">Storage?</span>
        <span class="question-bubble bubble-three" data-depth-layer="4">Farm visits?</span>
        <aside class="page-hero-note visual-note" data-depth-layer="2" aria-label="Contact note"><strong>Still curious?</strong>Send us a note on WhatsApp. A real person will reply around the farm day.</aside>
      </div>
</PageHero>
    <section class="section"><div class="container faq-layout">
      <aside class="faq-intro" data-reveal="left" aria-label="Frequently asked questions introduction"><p class="eyebrow">The essentials</p><h2>Farm, food and ordering.</h2><p>These answers reflect our current founding season and will evolve as the farm settles into a regular release rhythm.</p><a class="button button-secondary" href="/contact.html">Ask us directly</a></aside>
      <FaqAccordion items={faqs} class="reveal-right" />
    </div></section>
    <CtaBand eyebrow="Ready to try a batch?" title="Build an order, then say hello." description="We will confirm exactly what is available before anything is final." href="/shop.html" label="Order on WhatsApp" cream />
  </main>
</BaseLayout>
