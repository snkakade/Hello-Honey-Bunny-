---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

---

<BaseLayout
  title="Farm & Product Gallery | Hello Honey Bunny Pune"
  description="Step inside Hello Honey Bunny through an editorial gallery of the farm, goats, small-batch process and fresh goat dairy near Pune."
  canonicalPath="/gallery.html"
  activePage="gallery"
  image="/assets/images/editorial/farm-morning.webp"
>
  <main id="main">
<PageHero
  eyebrow="The farm in frames"
  title="Morning light. Honest work."
  description="A growing visual journal of the animals, the process and the small moments that make a farm feel alive."
  variant="gallery"
>
      <div slot="visual" class="page-hero-visual collage-stage" data-motion-scene data-reveal="right">
        <figure class="collage-card collage-one" data-depth-layer="1"><img src="/assets/images/editorial/farm-morning.webp" alt="Morning at the farm" width="1586" height="992"></figure>
        <figure class="collage-card collage-two" data-depth-layer="3"><img src="/assets/images/editorial/goat-portrait.webp" alt="Young goat in the meadow" width="1122" height="1402"></figure>
        <figure class="collage-card collage-three" data-depth-layer="2"><img src="/assets/images/editorial/dairy-still-life.webp" alt="Fresh dairy on the farm table" width="1448" height="1086"></figure>
        <span class="visual-chip visual-chip-top" data-depth-layer="4">A living visual journal</span>
        <aside class="page-hero-note visual-note" data-depth-layer="4"><strong>New frames, as the farm grows.</strong>Animals, process, products and the quiet work between them.</aside>
      </div>
</PageHero>
    <section class="section"><div class="container">
      <div class="filter-list" role="group" aria-label="Filter gallery" data-reveal>
        <button class="filter-button active" type="button" data-gallery-filter="all" aria-pressed="true">All</button><button class="filter-button" type="button" data-gallery-filter="farm" aria-pressed="false">Farm</button><button class="filter-button" type="button" data-gallery-filter="animals" aria-pressed="false">Animals</button><button class="filter-button" type="button" data-gallery-filter="process" aria-pressed="false">Process</button><button class="filter-button" type="button" data-gallery-filter="products" aria-pressed="false">Products</button><button class="filter-button" type="button" data-gallery-filter="film" aria-pressed="false">Film</button>
      </div>
      <div class="gallery-grid stagger">
        <button class="gallery-item wide tall" type="button" data-category="farm" data-reveal><img src="/assets/images/editorial/farm-morning.webp" alt="Soft morning light over a goat dairy farm near Pune" width="1586" height="992"><span class="gallery-caption"><span><strong>First light</strong><small>Farm · Pune countryside</small></span><span>↗</span></span></button>
        <button class="gallery-item tall" type="button" data-category="animals" data-reveal><img src="/assets/images/editorial/goat-portrait.webp" alt="Portrait of a calm young goat among meadow grass" loading="lazy" width="1122" height="1402"><span class="gallery-caption"><span><strong>In the meadow</strong><small>Animals · Morning</small></span><span>↗</span></span></button>
        <button class="gallery-item" type="button" data-category="products" data-reveal><img src="/assets/images/editorial/dairy-still-life.webp" alt="Fresh goat milk, curd, paneer and cheese on limestone" loading="lazy" width="1448" height="1086"><span class="gallery-caption"><span><strong>The first table</strong><small>Products · Still life</small></span><span>↗</span></span></button>
        <button class="gallery-item" type="button" data-category="process" data-reveal><img class="crop-milk" src="/assets/images/editorial/dairy-still-life.webp" alt="Clear cold bottle of fresh goat milk in window light" loading="lazy" width="1448" height="1086"><span class="gallery-caption"><span><strong>Chilled promptly</strong><small>Process · Fresh handling</small></span><span>↗</span></span></button>
        <button class="gallery-item wide" type="button" data-category="film" data-video="true" data-reveal><img class="film-image" src="/assets/images/editorial/farm-morning.webp" alt="Video placeholder showing goats by the farm shelter" loading="lazy" width="1586" height="992"><span class="gallery-caption always-visible"><span><strong>A morning at the farm</strong><small>Film placeholder · Coming soon</small></span><span class="play-icon" aria-hidden="true"></span></span></button>
        <button class="gallery-item" type="button" data-category="products" data-reveal><img class="crop-paneer" src="/assets/images/editorial/dairy-still-life.webp" alt="Fresh goat milk paneer set on parchment" loading="lazy" width="1448" height="1086"><span class="gallery-caption"><span><strong>Freshly set</strong><small>Products · Paneer</small></span><span>↗</span></span></button>
        <button class="gallery-item tall" type="button" data-category="animals" data-reveal><img class="crop-goat-face" src="/assets/images/editorial/goat-portrait.webp" alt="Detailed view of a young goat in warm natural light" loading="lazy" width="1122" height="1402"><span class="gallery-caption"><span><strong>Known by nature</strong><small>Animals · Portrait</small></span><span>↗</span></span></button>
        <button class="gallery-item" type="button" data-category="farm" data-reveal><img class="crop-farm-shelter" src="/assets/images/editorial/farm-morning.webp" alt="Timber goat shelter and grass in the Pune countryside" loading="lazy" width="1586" height="992"><span class="gallery-caption"><span><strong>Shelter</strong><small>Farm · Foundations</small></span><span>↗</span></span></button>
        <button class="gallery-item wide" type="button" data-category="film" data-video="true" data-reveal><img class="film-image-dark" src="/assets/images/editorial/dairy-still-life.webp" alt="Video placeholder showing the first small-batch dairy collection" loading="lazy" width="1448" height="1086"><span class="gallery-caption always-visible"><span><strong>From milk to table</strong><small>Film placeholder · Coming soon</small></span><span class="play-icon" aria-hidden="true"></span></span></button>
      </div>
    </div></section>
    <section class="section section-sm section-cream"><div class="container"><div class="cta-band" data-reveal><div class="cta-band-inner"><div><p class="eyebrow">Behind the scenes</p><h2>Want to see the farm in person?</h2><p>Farm visits are still being planned. Tell us you are interested and we will share details when a suitable day is ready.</p></div><a class="button button-light" href="/contact.html#visit">Register your interest</a></div></div></div></section>
  </main>
</BaseLayout>
