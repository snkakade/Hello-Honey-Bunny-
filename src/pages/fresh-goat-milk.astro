---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { Picture } from "astro:assets"; import { getProduct, statusLabels } from "../data/products"; import { breadcrumbSchema, productSchema } from "../utils/schema"; import { withBase } from "../config/site";
const product=getProduct("fresh-goat-milk"); const crumbs=[{name:"Home",path:"/"},{name:product.name,path:product.slug}];
---
<BaseLayout title={product.seoTitle!} description={product.seoDescription!} canonicalPath={product.slug} activePage="milk" image={product.image?.src} imageAlt={product.imageAlt} schema={[productSchema(product),breadcrumbSchema(crumbs)]}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:product.name}]} /><section class="page-intro"><div class="container hero-grid"><div><p class="status">{statusLabels[product.status]}</p><h1>Fresh goat milk in limited batches near Pune</h1><p class="lede">{product.longDescription} Availability, final pricing and the available pickup or delivery arrangement are confirmed personally on WhatsApp.</p><div class="button-row"><a class="button button-primary" href={withBase("/request-a-batch?product=fresh-goat-milk")}>Request fresh goat milk</a><a class="button button-secondary" href={withBase("/goat-milk-paneer")}>View goat milk paneer</a></div></div><div class="hero-media"><Picture src={product.image!} formats={["avif"]} fallbackFormat="webp" widths={[480,768,1100]} sizes="(max-width: 750px) 100vw, 48vw" alt={product.imageAlt!} fetchpriority="high" loading="eager" decoding="async" /></div></div></section><section class="section section-cream"><div class="container feature-grid"><article class="feature"><h2>Indicative pack sizes</h2><p>500 ml and 1 litre. Pack sizes are indicative and confirmed with each available batch.</p></article><article class="feature"><h2>Storage guidance</h2><p>{product.storageSummary} Use clean utensils.</p></article></div></section><section class="section"><div class="narrow"><h2>Dairy safety note</h2><p class="safe-note">Goat milk is still dairy and may contain lactose and milk proteins. Anyone with a diagnosed milk allergy, intolerance or medical dietary concern should seek advice from an appropriately qualified healthcare professional.</p><p><a href={withBase("/faqs")}>Read ordering and dairy safety FAQs</a> or <a href={withBase("/our-farm")}>learn about our Kunjirwadi farm</a>.</p></div></section></main></BaseLayout>
