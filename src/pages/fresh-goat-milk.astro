---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { Picture } from "astro:assets"; import { getProduct, statusLabels } from "../data/products"; import { breadcrumbSchema, productSchema } from "../utils/schema"; import { whatsappUrl, withBase } from "../config/site";
const product=getProduct("fresh-goat-milk"); const crumbs=[{name:"Home",path:"/"},{name:product.name,path:product.slug}]; const milkWhatsapp = whatsappUrl("Hello, I would like to check today's fresh goat milk batch. Please share the available quantity, pack size, final price and the available pickup or delivery arrangement for my area.");
---
<BaseLayout title={product.seoTitle!} description={product.seoDescription!} canonicalPath={product.slug} activePage="milk" image={product.image?.src} imageAlt={product.imageAlt} schema={[productSchema(product),breadcrumbSchema(crumbs)]}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:product.name}]} /><section class="page-intro"><div class="container hero-grid"><div><p class="status">{statusLabels[product.status]}</p><h1>Fresh goat milk in limited batches near Pune</h1><p class="lede">{product.longDescription} Availability, final pricing and the available pickup or delivery arrangement are confirmed personally on WhatsApp.</p><div class="button-row"><a class="button button-primary" href={withBase("/request-a-batch?product=fresh-goat-milk")}>Request fresh goat milk</a><a class="button button-secondary" href={withBase("/goat-milk-paneer")}>View goat milk paneer</a></div></div><div class="hero-media"><Picture src={product.image!} formats={["avif"]} fallbackFormat="webp" widths={[480,768,1100]} sizes="(max-width: 750px) 100vw, 48vw" alt={product.imageAlt!} fetchpriority="high" loading="eager" decoding="async" /></div></div></section><section class="section section-cream"><div class="container feature-grid"><article class="feature"><h2>Indicative pack sizes</h2><p>500 ml and 1 litre. Pack sizes are indicative and confirmed with each available batch.</p></article><article class="feature"><h2>Delivery around Pune</h2><p>Delivery requests are considered across Pune, nearby PCMC and our listed local areas. <a href={withBase("/delivery-areas")}>Check the current delivery areas</a>; route availability is confirmed with each batch.</p></article></div></section><section class="section"><div class="narrow"><h2>Dairy safety note</h2><p class="safe-note">Goat milk is still dairy and may contain lactose and milk proteins. Anyone with a diagnosed milk allergy, intolerance or medical dietary concern should seek advice from an appropriately qualified healthcare professional.</p><p><a href={withBase("/faqs")}>Read ordering and dairy safety FAQs</a> or <a href={withBase("/our-farm")}>learn about our Kunjirwadi farm</a>.</p></div></section><section class="section section-cream"><div class="container"><div class="section-heading"><p class="eyebrow">Ordering information</p><h2>Buying fresh goat milk near Pune</h2><p>Hello Honey Bunny offers fresh goat milk in limited batches from our dairy in Kunjirwadi, near Pune. Because production varies naturally between batches, current availability is confirmed before an order is accepted.</p></div><div class="feature-grid"><article class="feature"><h3>Farm location</h3><p>Kunjirwadi, Maharashtra 412201, near Pune.</p></article><article class="feature"><h3>Typical pack request</h3><p>Ask about 500 ml and 1 litre quantities, subject to the current batch.</p></article><article class="feature"><h3>Availability</h3><p>Batch based. Availability is confirmed before ordering.</p></article><article class="feature"><h3>Fulfilment</h3><p>Pickup or delivery depends on your location and the current route.</p></article></div><a class="button button-primary" href={milkWhatsapp} target="_blank" rel="noopener" data-analytics-location="fresh_milk_ordering_section" data-analytics-label="Check today's availability on WhatsApp">Check today's availability on WhatsApp</a></div></section><section class="section"><div class="narrow"><h2>Goat milk price and current availability</h2><p>We do not publish a permanent goat milk price because availability, quantity and fulfilment can vary between batches.</p><p>Tell us the quantity you need and your area. We will confirm the current batch, available pack size, final price and pickup or delivery arrangement before you decide.</p><a class="button button-secondary" href={withBase("/request-a-batch?product=fresh-goat-milk")} data-analytics-label="Ask for the current batch and price">Ask for the current batch and price</a></div></section><section class="section section-cream"><div class="narrow"><div class="section-heading"><p class="eyebrow">Direct answers</p><h2>Common questions about ordering goat milk</h2></div><div class="answer-stack"><article><h3>Can I buy fresh goat milk in Pune?</h3><p>Hello Honey Bunny offers fresh goat milk in limited batches from Kunjirwadi near Pune. Current availability, pack size, final pricing and the available pickup or delivery arrangement are confirmed before an order is accepted.</p></article><article><h3>Does Hello Honey Bunny deliver goat milk in Pune?</h3><p>Delivery requests are considered across our <a href={withBase("/delivery-areas")}>listed areas of Pune and nearby PCMC</a>, subject to the current batch and practical route availability.</p></article><article><h3>Where is Hello Honey Bunny based?</h3><p>Hello Honey Bunny is based in Kunjirwadi, Maharashtra 412201, near Pune. We operate as a service-area dairy and do not accept unarranged walk-in farm visits.</p></article><article><h3>How do I check whether goat milk is available today?</h3><p>Send the quantity and delivery or pickup area you need through WhatsApp. We will confirm the current batch before you place an order.</p></article><article><h3>Does goat milk contain lactose?</h3><p>Yes. Goat milk naturally contains lactose. It should not be described as automatically suitable for someone with lactose intolerance. If you have a diagnosed intolerance, milk allergy or medical dietary requirement, speak with an appropriately qualified healthcare professional.</p></article></div><p class="related-reading">For evidence-aware answers about nutrition, allergy and commonly searched health claims, read our <a href={withBase("/journal/goat-milk-benefits-nutrition")}>goat milk benefits and nutrition guide</a>.</p></div></section></main></BaseLayout>
