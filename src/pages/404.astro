---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { availabilityMessage, whatsappUrl, withBase } from "../config/site";
---
<BaseLayout title="Page Not Found | Hello Honey Bunny" description="The requested Hello Honey Bunny page could not be found." canonicalPath="/404" noindex={true}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"Page not found"}]} /><section class="page-intro"><div class="narrow"><p class="eyebrow">404</p><h1>We could not find that page</h1><p class="lede">Use one of the links below to return to current information.</p><div class="button-row"><a class="button button-primary" href={withBase("/")}>Go to the homepage</a><a class="button button-secondary" href={withBase("/products")}>View current products</a><a class="button button-secondary" href={whatsappUrl(availabilityMessage)} target="_blank" rel="noopener">Check current availability</a></div></div></section></main></BaseLayout>
