---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import ProductCard from "../components/ProductCard.astro";
import { plannedProducts, requestableProducts, statusLabels } from "../data/products"; import { breadcrumbSchema } from "../utils/schema";
---
<BaseLayout title="Goat Milk and Paneer Near Pune | Hello Honey Bunny" description="See the current goat milk products from Hello Honey Bunny near Pune. Fresh goat milk and goat milk paneer are subject to batch availability." canonicalPath="/products" schema={breadcrumbSchema([{name:"Home",path:"/"},{name:"Products",path:"/products"}])}>
<main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"Products"}]} /><section class="page-intro"><div class="container"><p class="eyebrow">Current range</p><h1>Current goat milk products from Hello Honey Bunny</h1><p class="lede">Fresh goat milk and goat milk paneer can be requested subject to the current batch. Pack sizes are indicative, and final details are confirmed personally.</p></div></section><section class="section section-cream"><div class="container"><div class="product-grid">{requestableProducts.map((product)=><ProductCard product={product}/>)}</div></div></section><section class="section" id="in-development"><div class="container"><div class="section-heading"><p class="eyebrow">Future range</p><h2>In development</h2><p>Goat milk curd, goat cheese and other farm products are being developed gradually. They are not currently available to order.</p></div><ul class="development-list">{plannedProducts.map((product)=><li><strong>{product.name}</strong><br><span>{statusLabels[product.status]}</span></li>)}</ul></div></section></main></BaseLayout>
