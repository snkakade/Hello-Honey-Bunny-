---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { breadcrumbSchema } from "../utils/schema"; import { requestableProducts } from "../data/products"; import { site, withBase } from "../config/site";
---
<BaseLayout title="Goat Dairy Supply Enquiries for Pune Food Businesses" description="Chefs, cafés, restaurants and specialist retailers can start a conversation with Hello Honey Bunny about small-batch goat dairy near Pune." canonicalPath="/for-chefs-and-retailers" activePage="business" schema={breadcrumbSchema([{name:"Home",path:"/"},{name:"For Food Businesses",path:"/for-chefs-and-retailers"}])}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"For Food Businesses"}]} /><section class="page-intro"><div class="container"><p class="eyebrow">Pune food businesses</p><h1>Small-batch goat dairy conversations for Pune food businesses</h1><p class="lede">Chefs, cafés, restaurants, premium grocers, boutique food retailers, caterers, hospitality businesses and specialty food stores may start a practical conversation about current or future requirements.</p></div></section><section class="section section-cream"><div class="container feature-grid"><article class="feature"><h2>What can be discussed</h2><p>Current products may be discussed subject to batch availability. The farm is intentionally limited in scale, and product consistency and practical format requirements can form part of the conversation.</p></article><article class="feature"><h2>What an enquiry means</h2><p>Early conversations may inform future development. An enquiry does not guarantee immediate supply, standing supply, a particular volume or a delivery arrangement.</p></article></div></section><section class="section"><div class="container business-form" data-business-form data-whatsapp={site.whatsappNumber} data-email={site.email}><div class="section-heading"><h2>Start a business enquiry</h2><p>Choose WhatsApp or email as your preferred handoff. You will see a formatted fallback if the handoff cannot be opened.</p></div><form id="business-form" novalidate><div class="field-grid"><div class="field"><label for="business-contact">Contact name *</label><input id="business-contact" name="contact" autocomplete="name" required aria-describedby="business-contact-error"><p class="field-error" id="business-contact-error"></p></div><div class="field"><label for="business-name">Business name *</label><input id="business-name" name="business" autocomplete="organization" required aria-describedby="business-name-error"><p class="field-error" id="business-name-error"></p></div><div class="field"><label for="business-type">Business type *</label><select id="business-type" name="type" required aria-describedby="business-type-error"><option value="">Select a business type</option><option>Chef</option><option>Café</option><option>Restaurant</option><option>Premium grocer</option><option>Boutique food retailer</option><option>Caterer</option><option>Hospitality business</option><option>Specialty food store</option></select><p class="field-error" id="business-type-error"></p></div><div class="field"><label for="business-location">Location *</label><input id="business-location" name="location" required aria-describedby="business-location-error"><p class="field-error" id="business-location-error"></p></div><div class="field"><label for="business-product">Product interest *</label><select id="business-product" name="product" required aria-describedby="business-product-error"><option value="">Select a product</option>{requestableProducts.map((product)=><option>{product.name}</option>)}<option>Future product development</option></select><p class="field-error" id="business-product-error"></p></div><div class="field"><label for="business-requirement">Approximate requirement</label><input id="business-requirement" name="requirement" placeholder="Describe the format or frequency you want to discuss"></div><div class="field"><label for="business-message">Message *</label><textarea id="business-message" name="message" required aria-describedby="business-message-error"></textarea><p class="field-error" id="business-message-error"></p></div><div class="field"><label for="business-method">Preferred contact method *</label><select id="business-method" name="method" required aria-describedby="business-method-error"><option value="">Select a method</option><option value="whatsapp">WhatsApp</option><option value="email">Email</option></select><p class="field-error" id="business-method-error"></p></div></div><button class="button button-primary" type="submit">Prepare business enquiry</button><p id="business-status" class="form-status" role="status" aria-live="polite"></p><p class="privacy-note">Your entries stay in this page until you continue to your chosen service. Read our <a href={withBase("/privacy")}>privacy information</a>.</p></form><div class="fallback" data-business-fallback hidden><h3>Your formatted enquiry</h3><pre data-business-text></pre><button type="button" class="button button-secondary" data-copy-business>Copy enquiry</button><p data-business-copy-status role="status" aria-live="polite"></p></div><p>Also see our <a href={withBase("/products")}>current products</a>, <a href={withBase("/our-farm")}>farm information</a> and <a href={withBase("/contact")}>contact details</a>.</p></div></section></main><script>import "../scripts/business-form.js";</script></BaseLayout>
