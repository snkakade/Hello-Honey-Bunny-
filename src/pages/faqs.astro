---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import FaqAccordion from "../components/FaqAccordion.astro"; import { faqs } from "../data/faqs"; import { breadcrumbSchema } from "../utils/schema";
const categories=[...new Set(faqs.map((item)=>item.category))];
---
<BaseLayout title="Goat Milk and Farm FAQs | Hello Honey Bunny" description="Answers about current goat milk products, pricing, storage, dairy safety, pickup or delivery, farm visits and food business enquiries." canonicalPath="/faqs" activePage="faqs" schema={breadcrumbSchema([{name:"Home",path:"/"},{name:"FAQs",path:"/faqs"}])}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"FAQs"}]} /><section class="page-intro"><div class="container"><p class="eyebrow">Clear answers</p><h1>Goat milk, ordering and farm visit questions</h1><p class="lede">Current details are confirmed personally because availability and practical arrangements can vary by batch.</p></div></section><section class="section section-cream"><div class="narrow">{categories.map((category)=><section><h2>{category}</h2><FaqAccordion items={faqs.filter((item)=>item.category===category)} /></section>)}</div></section></main></BaseLayout>
