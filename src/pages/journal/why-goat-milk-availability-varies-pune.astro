      <a class="button button-primary" href={withBase("/request-a-batch")} data-analytics-event="article_cta_click" data-analytics-label="Check fresh goat milk availability" data-article-slug="why-goat-milk-availability-varies-pune">Check fresh goat milk availability</a>
      <a class="button button-secondary" href={availabilityWhatsapp} target="_blank" rel="noopener" data-analytics-label="Contact Hello Honey Bunny on WhatsApp">Contact us on WhatsApp</a>
    </div>
    <p><small>Hello Honey Bunny is based in Kunjirwadi near Pune. All product and delivery arrangements remain subject to confirmation.</small></p>
  </DirectAnswer>
</ArticleLayout>
