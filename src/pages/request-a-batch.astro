---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { requestableProducts, statusLabels } from "../data/products"; import { site, withBase } from "../config/site"; import { breadcrumbSchema } from "../utils/schema";
---
<BaseLayout title="Request Goat Milk on WhatsApp | Hello Honey Bunny" description="Build a request for the current fresh goat milk or goat milk paneer batch, then continue to WhatsApp for availability and final pricing." canonicalPath="/request-a-batch" activePage="request" schema={breadcrumbSchema([{name:"Home",path:"/"},{name:"Request a Batch",path:"/request-a-batch"}])}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"Request a Batch"}]} /><section class="page-intro"><div class="container"><p class="eyebrow">Request builder</p><h1>Request the current goat milk or paneer batch</h1><p class="lede">Choose an indicative pack size and quantity. Your request is not confirmed until current availability, final pricing and an available pickup or delivery arrangement have been agreed.</p></div></section><section class="section section-cream"><div class="container request-layout" data-request-builder data-whatsapp={site.whatsappNumber} data-max-quantity={site.maxRequestQuantity}>
<div class="request-products"><h2>Choose products</h2>{requestableProducts.map((product)=><article class="request-product" data-product-id={product.id} data-product-name={product.name}><div><p class="status">{statusLabels[product.status]}</p><h3>{product.name}</h3></div>{product.indicativePackSizes.map((size)=><div class="pack-control" data-size={size}><span>{size}</span><div class="quantity-control" role="group" aria-label={`${product.name}, ${size} quantity`}><button type="button" data-action="decrease" aria-label={`Remove one ${product.name}, ${size}`}>−</button><output aria-live="polite">0</output><button type="button" data-action="increase" aria-label={`Add one ${product.name}, ${size}`}>+</button></div></div>)}</article>)}<p class="notice">Pack sizes are indicative. Current options are confirmed with each batch.</p></div>
<aside class="form-panel" aria-label="Request details"><h2>Your details</h2><form id="batch-form" novalidate><div class="field-grid"><div class="field"><label for="request-name">Name *</label><input id="request-name" name="name" autocomplete="name" required aria-describedby="request-name-error"><p class="field-error" id="request-name-error"></p></div><div class="field"><label for="request-area">Area or postcode *</label><input id="request-area" name="area" autocomplete="postal-code" required aria-describedby="request-area-help request-area-error"><p class="field-help" id="request-area-help">Current areas include Pune, nearby PCMC, Katraj, Hadapsar, Loni Kalbhor, Kunjirwadi and Uruli Kanchan. <a href={withBase("/delivery-areas")}>View details</a>.</p><p class="field-error" id="request-area-error"></p></div><div class="field"><label for="request-arrangement">Preferred arrangement *</label><select id="request-arrangement" name="arrangement" required aria-describedby="request-arrangement-error"><option value="">Select a preference</option><option>Pickup, if available</option><option>Delivery, if available</option><option>Either option</option></select><p class="field-error" id="request-arrangement-error"></p></div><div class="field"><label for="request-date">Preferred date</label><input id="request-date" name="date" type="date" aria-describedby="request-date-error"><p class="field-error" id="request-date-error"></p></div><div class="field"><label for="request-notes">Notes</label><textarea id="request-notes" name="notes" placeholder="Timing or practical details"></textarea></div></div><button class="button button-primary" type="submit">Send request on WhatsApp</button><p id="request-status" class="form-status" role="status" aria-live="polite"></p><p class="privacy-note">Your entries stay in this page until you continue to WhatsApp. Read our <a href={withBase("/privacy")}>privacy information</a>.</p></form><div class="fallback" data-fallback hidden><h3>Your formatted request</h3><pre data-request-text></pre><button class="button button-secondary" type="button" data-copy-request>Copy request</button><p>WhatsApp: {site.phoneDisplay}</p><p data-copy-status role="status" aria-live="polite"></p></div></aside>
</div></section></main><script>import "../scripts/request-builder.js";</script></BaseLayout>
