---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

---

<BaseLayout
  title="Contact & Visit Hello Honey Bunny | Goat Dairy Near Pune"
  description="Contact Hello Honey Bunny near Pune for fresh goat dairy orders, farm visit interest, café partnerships, retail supply and general enquiries."
  canonicalPath="/contact.html"
  activePage="contact"
  image="/assets/images/editorial/goat-portrait.webp"
>
  <main id="main">
<PageHero
  eyebrow="Come say hello"
  title="A real farm. A real conversation."
  description="Orders, partnerships, farm visits and good questions are all welcome. We reply around the rhythms of the farm."
  variant="contact"
>
      <div slot="visual" class="page-hero-visual contact-stage" data-motion-scene data-reveal="right">
        <div class="visual-frame" data-depth-layer="1"><img src="/assets/images/editorial/farm-morning.webp" alt="Hello Honey Bunny farm in the countryside near Pune" width="1586" height="992"></div>
        <span class="location-pin" data-depth-layer="4" aria-hidden="true"><span>Near<br>Pune</span></span>
        <span class="message-bubble" data-depth-layer="3">Hello 👋<small>Usually quickest on WhatsApp</small></span>
        <aside class="page-hero-note visual-note" data-depth-layer="2"><strong>The quickest route</strong>WhatsApp is best for current availability and local order questions.</aside>
      </div>
</PageHero>
    <section class="section"><div class="container contact-grid">
      <div class="contact-cards" data-reveal="left">
        <article class="contact-card"><p class="eyebrow">WhatsApp</p><h3>Orders &amp; availability</h3><p><a href="https://wa.me/918208665234" target="_blank" rel="noopener">+91 8208 665 234</a><br>Best for quick batch and delivery questions.</p></article>
        <article class="contact-card"><p class="eyebrow">Email</p><h3>General enquiries</h3><p><a href="mailto:visit@hellohoneybunny.com">visit@hellohoneybunny.com</a><br>Useful for partnerships and longer notes.</p></article>
        <article class="contact-card"><p class="eyebrow">Location</p><h3>Near Pune</h3><p>Kunjirwadi, Maharashtra 412201, India.<br>Visits are by prior confirmation only.</p></article>
      </div>
      <div class="contact-form" data-reveal="right">
        <p class="eyebrow">Send an enquiry</p><h2>What can we help with?</h2>
        <!-- Future backend: connect this form to your CRM or form API and replace the WhatsApp handler in js/main.js. -->
        <form id="contact-form">
          <div class="field-grid">
            <div class="field-row"><div class="field"><label for="contact-name">Name *</label><input id="contact-name" name="name" type="text" autocomplete="name" required></div><div class="field"><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email"></div></div>
            <div class="field"><label for="contact-type">Enquiry type</label><select id="contact-type" name="type"><option>General question</option><option>Product availability</option><option>Café or retail partnership</option><option>Farm visit interest</option><option>Press or collaboration</option></select></div>
            <div class="field"><label for="contact-message">Message *</label><textarea id="contact-message" name="message" placeholder="Tell us a little about what you need" required></textarea></div>
          </div>
          <button class="button button-primary" type="submit">Continue in WhatsApp</button><p id="contact-status" class="form-status" role="status" aria-live="polite"></p><p class="fine-print">This form currently opens WhatsApp. It does not store your information on this website.</p>
        </form>
      </div>
    </div></section>
    <section class="section section-cream" id="partners"><div class="container story-grid">
      <div class="story-media landscape" data-reveal="left"><img src="/assets/images/editorial/dairy-still-life.webp" alt="Goat milk, paneer, curd and artisanal cheese for professional kitchens" loading="lazy" width="1448" height="1086"></div>
      <div class="story-copy" data-reveal="right"><p class="eyebrow">For cafés &amp; retailers</p><h2>Thoughtful supply for thoughtful shelves.</h2><p class="large-copy">We are interested in a small circle of chefs, cafés and boutique stores that value seasonal availability and a clear farm story.</p><p>Tell us about your kitchen, preferred products and likely volume. Early conversations help us plan formats and batch sizes responsibly; they are not a promise of immediate supply.</p><a class="button button-secondary" href="mailto:visit@hellohoneybunny.com?subject=Cafe%20or%20retail%20partnership">Start a partnership conversation</a></div>
    </div></section>
    <section class="section" id="visit"><div class="container contact-grid">
      <div data-reveal="left"><p class="eyebrow">Visit the farm</p><h2>See where the day begins.</h2><p class="lede">Occasional farm visits are being planned for small groups. They will be calm, guided and arranged around animal care—not fixed public opening hours.</p><p>Please register interest before making the journey. We will share a date, time, directions and any visitor guidance once a visit is confirmed.</p><div class="button-row"><a class="button button-primary" href="https://wa.me/918208665234?text=Hello%20Hello%20Honey%20Bunny%2C%20I%27d%20like%20to%20register%20interest%20in%20a%20future%20farm%20visit." target="_blank" rel="noopener">Register on WhatsApp</a></div></div>
      <div class="map-card" data-reveal="right" role="img" aria-label="Map-ready placeholder showing Kunjirwadi near Pune"><div class="map-marker"><span>Near<br>Pune</span></div></div>
    </div></section>
  </main>
</BaseLayout>
