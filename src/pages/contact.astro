---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro"; import { site, availabilityMessage, whatsappUrl, withBase } from "../config/site"; import { breadcrumbSchema } from "../utils/schema";
---
<BaseLayout title="Contact Hello Honey Bunny Near Pune" description="Contact Hello Honey Bunny in Kunjirwadi about goat milk availability and delivery requests across Pune, nearby PCMC and listed local areas." canonicalPath="/contact" schema={breadcrumbSchema([{name:"Home",path:"/"},{name:"Contact",path:"/contact"}])}><main id="main"><Breadcrumbs items={[{name:"Home",path:"/"},{name:"Contact"}]} /><section class="page-intro"><div class="container"><p class="eyebrow">Talk to us</p><h1>Contact Hello Honey Bunny</h1><p class="lede">Ask about the current batch, delivery to your area, a future food business conversation or farm visit interest.</p></div></section><section class="section section-cream"><div class="container"><div class="contact-grid"><article class="contact-card"><h2>WhatsApp</h2><p><a href={whatsappUrl(availabilityMessage)} target="_blank" rel="noopener">{site.phoneDisplay}</a></p><p>Availability, final pricing and the available pickup or delivery arrangement are confirmed personally.</p></article><article class="contact-card"><h2>Email</h2><p><a href={`mailto:${site.email}`}>{site.email}</a></p><p>For general questions and food business conversations.</p></article><article class="contact-card"><h2>Farm base</h2><p>{site.location}</p><p>Farm visits require prior confirmation. Private directions and public opening hours are not published.</p></article></div><div class="delivery-summary"><p class="eyebrow">Current service area</p><h2>Delivery requests across Pune and nearby PCMC</h2><p>Current listed areas are {site.deliveryAreas.join(", ")}. Delivery depends on batch availability, route capacity and your confirmed arrangement.</p><a class="button button-secondary" href={withBase("/delivery-areas")}>See delivery-area details</a></div><p class="contact-actions"><a class="button button-secondary" href={withBase("/for-chefs-and-retailers")}>Food business enquiry page</a></p></div></section></main></BaseLayout>
